{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 2,
    "name": "gutenberg-blocks/slider",
    "title": "Slider",
    "description": "A slider/carousel block that displays multiple slides.",
    "textdomain": "default",
    "category": "design",
    "icon": "slides",
    "attributes": {
      "autoplay": {
        "type": "boolean",
        "default": true
      },
      "autoplaySpeed": {
        "type": "number",
        "default": 2000
      },
      "showArrows": {
        "type": "boolean",
        "default": true
      },
      "showDots": {
        "type": "boolean",
        "default": false
      }
    },
    "supports": {
      "align": ["wide", "full"],
      "anchor": true
    },
    "allowedBlocks": ["gutenberg-blocks/slide"]
  }
  